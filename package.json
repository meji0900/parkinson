{
  "name": "engram",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "chain:build": "cd chain && cargo-build-sbf --manifest-path programs/engram_registry/Cargo.toml --sbf-out-dir target/deploy",
    "chain:deploy": "solana program deploy chain/target/deploy/engram_registry.so --program-id .keys/engram_registry-keypair.json --url devnet",
    "chain:init": "node scripts/chain-init.mjs",
    "agent:key": "solana-keygen new --no-bip39-passphrase -o .keys/agent.json",
    "agent:address": "solana-keygen pubkey .keys/agent.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@solana/wallet-adapter-base": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.40",
    "@solana/web3.js": "^1.99.0",
    "@types/three": "^0.186.0",
    "bs58": "^6.0.0",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
