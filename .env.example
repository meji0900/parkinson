# ---------------------------------------------------------------- site
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_X_HANDLE=engram_agent
# mainnet token contract address once it launches (shown in the header, click to copy)
NEXT_PUBLIC_TOKEN_CA=

# ---------------------------------------------------------------- the agent
# seconds between genes on the live loop (the reference project used 150)
AGENT_INTERVAL_SECONDS=150
# milliseconds between events while the agent works live (the typing pace)
AGENT_PACE_MS=650
# set to off on serverless hosts and call /api/cron from a scheduler instead
AGENT_WORKER=on
# protects /api/cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# fresh visitor runs per IP per hour (replays of genes read in the last 12 hours are free)
RUNS_PER_HOUR=12
# optional: raises the PubMed rate limit from 3 to 10 requests a second
NCBI_API_KEY=
# where the ledger lives (SQLite, built into Node 24); keep it on a persistent disk
ENGRAM_DB=./data/engram.db

# ---------------------------------------------------------------- questions in the console
# optional: with a key, the agent's answers are written by Claude from its records; without, plain lookups answer
ANTHROPIC_API_KEY=
ASK_MODEL=claude-opus-5-5

# ---------------------------------------------------------------- the atlas
# real pseudobulk data (see scripts/build_pseudobulk.py); without it a simulated, clearly labelled cohort is used
ATLAS_DIR=./data/atlas
ATLAS_PRIMARY=sea-ad-mtg
ATLAS_SECOND=sea-ad-pfc

# ---------------------------------------------------------------- Solana
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# server-side RPC (a private endpoint is better for the oracle); defaults to the public one
SOLANA_RPC_URL=
NEXT_PUBLIC_PROGRAM_ID=7WZ76mDSPhihpu6fCxejbKbaffVJKxedcjb4jGNnEADn
# test tokens a wallet must hold to queue a gene
NEXT_PUBLIC_GATE_AMOUNT=100
# the agent's key (oracle + fee payer): a path, or the secret itself (JSON array or base58) for hosts without files
AGENT_KEYPAIR_PATH=./.keys/agent.json
AGENT_SECRET_KEY=
# set to false to keep everything off-chain
CHAIN_ENABLED=true
