# ---------------------------------------------------------------- site
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# your X handle without the @ (leave empty to hide the X link)
NEXT_PUBLIC_X_HANDLE=
# mainnet token contract address once it launches (shown in the header, click to copy)
NEXT_PUBLIC_TOKEN_CA=

# ---------------------------------------------------------------- the agent
# seconds between genes on the live loop (the reference project used 150)
AGENT_INTERVAL_SECONDS=150
# milliseconds between events while the agent works live (the typing pace)
AGENT_PACE_MS=650
# seconds the live agent's sealed predictions stay open for forecasts before they are tested (0 tests at once)
FORECAST_WINDOW_SECONDS=600
# set to off on serverless hosts and call /api/cron from a scheduler instead
AGENT_WORKER=on
# protects /api/cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
# fresh visitor runs per IP per hour (replays of genes read in the last 12 hours are free)
RUNS_PER_HOUR=12
# optional: raises the PubMed rate limit from 3 to 10 requests a second
NCBI_API_KEY=
# where the ledger lives (SQLite, built into Node 24); keep it on a persistent disk (JAMES_DB, the old name, still works)
PARKINSON_DB=./data/parkinson.db

# ---------------------------------------------------------------- questions in the console
# optional: with a key, the agent's answers are written by Claude from its records; without, plain lookups answer
ANTHROPIC_API_KEY=
ASK_MODEL=claude-opus-5-5

# ---------------------------------------------------------------- the atlas
# real pseudobulk atlases, built by scripts/build_real_atlas.py and shipped in data/atlas: Volpato et al. 2025 (primary,
# staged donors) and Kamath et al. 2022 (independent confirmation cohort). ATLAS_PRIMARY=simulated runs the simulation instead.
ATLAS_DIR=./data/atlas
ATLAS_PRIMARY=pd-snpc
ATLAS_SECOND=pd-sn-kamath

# ---------------------------------------------------------------- Robinhood Chain (an Ethereum L2 on Arbitrum, ETH for gas)
# testnet (chain 46630) | mainnet (chain 4663) | local (anvil, chain 31337)
NEXT_PUBLIC_NETWORK=testnet
# the RPC wallets are given; empty = the official public one. Where *.robinhood.com is blocked (some Indonesian ISPs),
# use https://robinhood-testnet.drpc.org (testnet) or https://robinhood.drpc.org (mainnet)
NEXT_PUBLIC_RPC_URL=
# the server's own RPC; a keyed one is better for the oracle (https://robinhood-testnet.g.alchemy.com/v2/<key>). Never NEXT_PUBLIC.
RPC_URL=
# the registry; empty = the address in lib/chain/deployments.json for this network
NEXT_PUBLIC_REGISTRY_ADDRESS=
# the token a wallet must hold to queue a gene; empty = the test token off mainnet, NEXT_PUBLIC_TOKEN_CA on mainnet
NEXT_PUBLIC_GATE_TOKEN=
NEXT_PUBLIC_GATE_AMOUNT=100
# the agent's key (oracle and gas payer). On a host: the hex private key, set from a terminal, never written in the repo.
# On this machine leave it empty and the encrypted keystore below (npm run wallet:new) is unlocked with its password file.
SIGNER_PRIVATE_KEY=
SIGNER_KEYSTORE=./.keys/evm-testnet
SIGNER_PASSWORD_FILE=./.keys/evm-testnet.pass
# set to false to keep everything off-chain
CHAIN_ENABLED=true
